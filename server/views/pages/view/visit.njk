{% extends "partials/layout.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = "Official visit details" %}
{% set backUrl = "/view/list" %}

{% block content %}
  <span class="govuk-hint">{{ visit.prisoner | firstNameSpaceLastName }} ({{ visit.prisoner.prisonerNumber }})</span>
  <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

  {{ govukSummaryList({
    rows: [
      { key: { text: "Prisoner" }, value: { text: (visit.prisoner | firstNameSpaceLastName) + " (" + visit.prisoner.prisonerNumber + ")" } },
      { key: { text: "Date" }, value: { text: visit.visitDate | formatDate } },
      { key: { text: "Time" }, value: { text: (visit.startTime | timeStringTo12HourPretty) + " to " + (visit.endTime | timeStringTo12HourPretty) } },
      { key: { text: "Location" }, value: { text: visit.locationDescription } },
      { key: { text: "Visit type" }, value: { text: visit.visitTypeDescription } },
      { key: { text: "Status" }, value: { text: visit.visitStatusDescription } },
      { key: { text: "Staff notes" }, value: { text: visit.staffNotes or "None" } },
      { key: { text: "Prisoner notes" }, value: { text: visit.prisonerNotes or "None" } }
    ]
  }) }}

  <h2 class="govuk-heading-m">Visitors</h2>
  {% set visitors = visit.officialVisitors.concat(visit.socialVisitors) %}
  {% if (visitors | length) > 0 %}
    <ul class="govuk-list govuk-list--bullet">
      {% for contact in visitors %}
        <li>{{ contact.firstName }} {{ contact.lastName }} ({{ contact.relationshipDescription }})</li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="govuk-body">No visitors recorded.</p>
  {% endif %}

  {% if user | hasPermission(PERMISSION.MANAGE) %}
    {{ govukButton({ text: "Amend this visit", href: "/manage/amend/" + visit.officialVisitId }) }}
  {% endif %}
{% endblock %}
