{% extends "partials/layout.njk" %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "partials/createJourneyHeader.njk" import createJourneyHeader %}

{% set pageTitle = "Check and confirm the official visit details" %}
{% set backUrl = "/manage/create/comments" %}

{% block content %}
  {{ createJourneyHeader(prisoner, stepsChecked) }}

  <span class="govuk-hint">Book an official visit</span>
  <h1 class="govuk-heading-l">{{ pageTitle }}</h1>

  <h2 class="govuk-heading-m">Visit details</h2>
  {{ govukSummaryList({
    rows: [
      {
        key: { text: "Prisoner" },
        value: { text: (prisoner | firstNameSpaceLastName) + " (" + prisoner.prisonerNumber + ")" },
        actions: { items: [{ href: "/manage/create/results", text: "Change", visuallyHiddenText: "the selected prisoner" }] }
      },
      {
        key: { text: "Visit type" },
        value: { text: visit.visitTypeDescription },
        actions: { items: [{ href: "/manage/create/visit-type", text: "Change", visuallyHiddenText: "the type of visit" }] }
      },
      {
        key: { text: "Date" },
        value: { text: visit.selectedTimeSlot.visitDate | formatDate("EEEE, d MMMM yyyy") },
        actions: { items: [{ href: "/manage/create/time-slot", text: "Change", visuallyHiddenText: "the date of the visit" }] }
      },
      {
        key: { text: "Time" },
        value: { text: (visit.selectedTimeSlot.startTime | timeStringTo12HourPretty) + " to " + (visit.selectedTimeSlot.endTime | timeStringTo12HourPretty) },
        actions: { items: [{ href: "/manage/create/time-slot", text: "Change", visuallyHiddenText: "the time of the visit" }] }
      },
      {
        key: { text: "Location" },
        value: { text: visit.selectedTimeSlot.locationDescription },
        actions: { items: [{ href: "/manage/create/time-slot", text: "Change", visuallyHiddenText: "the location of the visit" }] }
      },
      {
        key: { text: "Staff notes" },
        value: { text: visit.staffNotes or "None" },
        actions: { items: [{ href: "/manage/create/comments", text: "Change", visuallyHiddenText: "staff notes" }] }
      },
      {
        key: { text: "Prisoner notes" },
        value: { text: visit.prisonerNotes or "None" },
        actions: { items: [{ href: "/manage/create/comments", text: "Change", visuallyHiddenText: "prisoner notes" }] }
      }
    ]
  }) }}

  <h2 class="govuk-heading-m">Visitors</h2>
  {% for contact in contacts %}
    <h3 class="govuk-heading-s govuk-!-margin-bottom-1">{{ contact.firstName }} {{ contact.lastName }} ({{ contact.relationshipDescription }})</h3>
    {% set rows = [
      { key: { text: "Needs assistance?" }, value: { text: "Yes" if contact.assistedVisit else "No" } },
      { key: { text: "Assistance details" }, value: { text: contact.assistanceNotes or "None" } } if contact.assistedVisit
    ] %}
    {% if showEquipment %}
      {% set rows = (rows.push(
        { key: { text: "Needs equipment?" }, value: { text: "Yes" if contact.equipment else "No" } }
      ), rows) %}
      {% if contact.equipment %}
        {% set rows = (rows.push(
          { key: { text: "Equipment details" }, value: { text: contact.equipmentNotes or "None" } }
        ), rows) %}
      {% endif %}
    {% endif %}
    {{ govukSummaryList({ classes: "govuk-!-margin-bottom-6", rows: rows | filterNonFalsy }) }}
  {% else %}
    <p class="govuk-body">No visitors selected.</p>
  {% endfor %}

  <form method="post">
    {{ govukButton({ text: "Create official visit" }) }}
  </form>
{% endblock %}
