{% extends "partials/layout.njk" %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "partials/createJourneyHeader.njk" import createJourneyHeader %}

{% set pageTitle = "Choose a date and time" %}
{% set backUrl = "/manage/create/visit-type" %}

{% block content %}
  {{ createJourneyHeader(prisoner, stepsChecked) }}

  <span class="govuk-hint">Book an official visit</span>

  <form method="post">
    {{ govukRadios({
      idPrefix: "timeSlot",
      name: "timeSlot",
      fieldset: {
        legend: {
          text: pageTitle,
          isPageHeading: true,
          classes: "govuk-fieldset__legend--l"
        }
      },
      items: items,
      errorMessage: validationErrors | findError('timeSlot')
    }) }}

    {{ govukButton({ text: "Continue" }) }}
  </form>
{% endblock %}
