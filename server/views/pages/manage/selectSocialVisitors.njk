{% extends "partials/layout.njk" %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "partials/createJourneyHeader.njk" import createJourneyHeader %}

{% set pageTitle = "Are any social contacts visiting?" %}

{% block content %}
  {{ createJourneyHeader(prisoner, stepsChecked) }}

  <span class="govuk-hint">Book an official visit</span>

  <form method="post">
    {{ govukCheckboxes({
      idPrefix: "visitors",
      name: "visitors",
      fieldset: {
        legend: {
          text: pageTitle,
          isPageHeading: true,
          classes: "govuk-fieldset__legend--l"
        }
      },
      hint: { text: "Optional. Select any approved social contacts also attending this visit." },
      items: items
    }) }}

    {{ govukButton({ text: submitText or "Continue" }) }}
  </form>
{% endblock %}
