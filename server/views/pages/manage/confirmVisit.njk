{% extends "partials/layout.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}

{% set prisonerName = prisoner | firstNameSpaceLastName %}
{% set pageTitle = "Official visit booked for " + prisonerName %}
{% set hideBetaBanner = true %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: "New official visit booked",
        html: "<b>Prisoner:</b> " + prisonerName + " (" + prisoner.prisonerNumber + ")"
      }) }}

      <p class="govuk-body">You have successfully booked an official visit with:</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for contact in officialVisitors %}
          <li>{{ contact.firstName }} {{ contact.lastName }} ({{ contact.relationshipDescription }})</li>
        {% endfor %}
      </ul>

      <p class="govuk-body" id="visit-details">
        The visit will take place on {{ visit.visitDate | formatDate("EEEE, d MMMM yyyy") }}
        from {{ visit.startTime | timeStringTo12HourPretty }} to {{ visit.endTime | timeStringTo12HourPretty }}
        in {{ visit.locationDescription }}.
      </p>

      <h2 class="govuk-heading-m">What you can do next</h2>
      <ul class="govuk-list">
        <li class="govuk-!-margin-bottom-2">
          <a href="/view/visit/{{ officialVisitId }}" class="govuk-link govuk-link--no-visited-state">View visit</a>
        </li>
        <li class="govuk-!-margin-bottom-2">
          <a href="/manage/create/search" class="govuk-link govuk-link--no-visited-state">Book another visit</a>
        </li>
        <li>
          <a href="/" class="govuk-link govuk-link--no-visited-state">Return to the homepage</a>
        </li>
      </ul>
    </div>
  </div>
{% endblock %}
